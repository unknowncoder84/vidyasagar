# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to "true" to force demo mode (no login page, auto sign-in as a demo
# admin, built-in sample courts/case types/districts/cases) regardless of
# the Supabase values above. Useful for live previews before a real
# database is connected. Remove or set to "false" once you go live.
VITE_DEMO_MODE=false
